# DriftBeacon local/demo deployment settings.
# Copy to .env before running docker compose. Do not commit .env.

# For local Compose smoke tests, leave this as HTTP localhost.
# For a real demo host with DNS pointing at the instance, use:
# DRIFTBEACON_SITE_ADDRESS=driftbeacon.example.com
DRIFTBEACON_SITE_ADDRESS=http://localhost:8080

# Optional Slack webhook env var for CLI reports. Leave empty unless needed.
SLACK_WEBHOOK_URL=

# Persistent web state.
DRIFTBEACON_WEB_DATABASE=/data/web.sqlite3
DRIFTBEACON_WEB_REPORT_DIR=/data/reports
DRIFTBEACON_SCAN_WORK_DIR=/work/scans
DRIFTBEACON_WEB_RETENTION_DAYS=7

# Public-demo abuse limits.
DRIFTBEACON_WEB_MAX_QUEUED_SCANS=10
DRIFTBEACON_WEB_MAX_SCAN_SECONDS=300
DRIFTBEACON_WEB_MAX_REPOSITORY_BYTES=157286400
DRIFTBEACON_WEB_MAX_REPOSITORY_FILES=8000
DRIFTBEACON_WEB_SCANS_PER_HOUR=10

# Worker settings.
DRIFTBEACON_WORKER_ID=worker-1
DRIFTBEACON_WORKER_POLL_SECONDS=2
DRIFTBEACON_WORKER_STALE_SECONDS=600
